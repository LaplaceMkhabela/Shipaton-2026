# Copy to .env and fill in. .env is gitignored — this repo is public.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
# See GitHub issue #1.
#
# The anon key is safe in the client by design; row-level security is the
# boundary, not the key. The service_role key must NEVER go in this file —
# it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat -> Project Settings -> API keys. These are public SDK keys, not
# the secret key; the secret one belongs only in the webhook edge function.
# Android is the target platform, so the Android key is the one that matters.
# Leave a key blank and the paywall reports itself unavailable rather than
# crashing — see src/lib/purchases/client.ts.
EXPO_PUBLIC_RC_ANDROID_KEY=your-revenuecat-android-key
EXPO_PUBLIC_RC_IOS_KEY=

# Fallback checkout for builds with no store billing — see PLAN.md risk R2.
EXPO_PUBLIC_RC_WEB_BILLING_URL=
