# Copy to .env and fill in. .env is gitignored — this repo is public.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
# See GitHub issue #1.
#
# The anon key is safe in the client by design; row-level security is the
# boundary, not the key. The service_role key must NEVER go in this file —
# it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
